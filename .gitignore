# Ignore Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments (important!)
.venv/
venv/
classiq-venv/

# Ignore build artifacts
build/
dist/
*.egg-info/
*.egg
*.whl

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore logs and database files
*.log
*.sqlite3
*.sqlite3-journal

# Ignore Pytest, coverage, and testing cache
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Ignore editor/IDE-specific files
.vscode/
.idea/
*.sublime-workspace

# Ignore Sphinx documentation build
docs/_build/

# Ignore poetry and dependency lock files (optional)
poetry.lock
pdm.lock
pdm.toml

# Ignore IPython and Jupyter configuration
profile_default/
ipython_config.py

# Ignore temporary files
.DS_Store
Thumbs.db
*.swp
*.swo

# Ignore Classiq and Qiskit-specific temporary data
*.pkl
*.h5
*.hdf5
*.log
*.npy

# Ignore git submodules (if applicable)
.git/modules/
